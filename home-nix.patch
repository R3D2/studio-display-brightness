# studio-display-brightness in the wayle bar, by hand
#
# Two edits inside services.wayle.settings, the same shape as the timer's.
# Apply with sudo, then `sudo nixos-rebuild switch`.

# ---------------------------------------------------------------- 1. layout
# Add "custom-studio-display-brightness" to whichever group you want it in. Next to
# the clock keeps it away from the notification and tray click targets:

           center = [ "clock" "custom-odoo-timesheet-timer" "custom-studio-display-brightness" "notifications" "systray" ];

# ------------------------------------------------------------- 2. the module
# Inside the `modules = { ... }` block, in the same `custom` list as the timer.
# `custom` is a list, and the id is what the layout name refers to:
# id = "studio-display-brightness" becomes "custom-studio-display-brightness".

        custom = [
          {
            id = "odoo-timesheet-timer";
            # ... the existing entry, unchanged ...
          }
          {
            id = "studio-display-brightness";
            command = "${studio-display-brightness}/bin/studio-display-brightness watch";
            mode = "watch";
            restart-policy = "on-exit";
            format = "{{ text }}";
            tooltip-format = "{{ tooltip }}";
            class-format = "{{ class }}";

            # A custom module is not told which bar it is drawn on, so it
            # follows the focused screen. With input:follow_mouse = 1 the
            # focused screen is the one under the pointer, so scrolling on a
            # bar changes the display that bar belongs to.
            scroll-up = "${studio-display-brightness}/bin/studio-display-brightness up";
            scroll-down = "${studio-display-brightness}/bin/studio-display-brightness down";
            left-click = "${studio-display-brightness}/bin/studio-display-brightness cycle";
            right-click = "${studio-display-brightness}/bin/studio-display-brightness set 100";
          }
        ];

# --------------------------------------------------------------- 3. the input
# `studio-display-brightness` needs to be in scope. Alongside the timer's let binding:

  let
    studio-display-brightness = inputs.studio-display-brightness.packages.${pkgs.system}.default;
  in

# and as a flake input:
#
#   studio-display-brightness.url = "github:OWNER/studio-display-brightness";

# ------------------------------------------------------- 4. keyboard, optional
# The brightness keys on a keyboard, in the Hyprland config. These act on the
# focused screen, same as the scroll:
#
#   bind = , XF86MonBrightnessUp,   exec, studio-display-brightness up
#   bind = , XF86MonBrightnessDown, exec, studio-display-brightness down
